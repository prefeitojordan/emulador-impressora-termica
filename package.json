{
  "name": "emulador-impressora-termica",
  "version": "1.0.1",
  "description": "Impressora térmica ESC/POS virtual para Windows: o cupom aparece no canto da tela com o papel subindo. TCP 9100, HTTP, QR Code, código de barras, NFC-e.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "teste": "node exemplos/enviar-teste.js",
    "dist": "electron-builder --win portable nsis",
    "capturas": "electron tools/capture.js"
  },
  "license": "MIT",
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "gifenc": "^1.0.3"
  },
  "author": "Maicon Rodrigues",
  "repository": {
    "type": "git",
    "url": "https://github.com/prefeitojordan/emulador-impressora-termica.git"
  },
  "build": {
    "appId": "emulador.impressora.termica",
    "productName": "Emulador Impressora Termica",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/jsbarcode/dist/JsBarcode.all.min.js"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "EmuladorImpressoraTermica-${version}-portatil.exe"
    },
    "nsis": {
      "artifactName": "EmuladorImpressoraTermica-${version}-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Emulador Impressora Térmica"
    },
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "escpos",
    "thermal-printer",
    "impressora-termica",
    "emulador",
    "nfce",
    "pdv",
    "electron"
  ]
}
